# MedInson Relay Server — Online Booking
# Copy this file to .env and fill in real values.
# All three vars are read by src/lib/medinsonBooking.js

# Base URL of the MedInson relay server (no trailing slash)
VITE_MEDINSON_API_URL=https://dentist-medinson-license.uz

# 10-character site code shown in the clinic's MedInson app → Settings → Website
# Using ?site= guarantees the correct dentist is resolved on localhost, Vercel
# preview URLs, and the production custom domain alike.
VITE_MEDINSON_SITE_ID=mr7c3fxzwy

# Custom domain registered on the MedInson account (kept as a human-readable
# reference; the site= param above takes priority in all environments)
VITE_MEDINSON_DOMAIN=drmunojat.uz
