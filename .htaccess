# ═══════════════════════════════════════════════════════════════════════════
# Apache config for the prerendered build (ahost.uz / cPanel).
#
# The critical part is what is NOT here: there is no SPA fallback rewriting
# every path to index.html. Each real route is prerendered to its own file, so
# an unmatched path must answer a genuine 404. Rewriting everything to
# index.html makes unknown URLs return 200 with homepage content, which is the
# soft-404 pattern this build exists to avoid.
# ═══════════════════════════════════════════════════════════════════════════

Options -Indexes
DirectoryIndex index.html

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical host: send www to the bare domain, one 301, no chain.
  RewriteCond %{HTTP_HOST} ^www\.drmunojat\.uz$ [NC]
  RewriteRule ^(.*)$ https://drmunojat.uz/$1 [R=301,L]

  # Force HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://drmunojat.uz/$1 [R=301,L]

  # A directory with an index.html is served as-is (/about -> /about/index.html).
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # Anything else that does not exist falls through to ErrorDocument 404.
</IfModule>

# Hashed assets never change contents, so they can be cached hard.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType video/mp4                 "access plus 1 month"
  # HTML is regenerated on every deploy and must revalidate.
  ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|png|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/xml
</IfModule>
